---
interface Props { heading: string; route: string }
import { pageHref } from "../paths";
const { heading, route } = Astro.props;
const section = route.startsWith("services/") ? { label: "Services", target: "service" } : route.startsWith("blogs/") ? { label: "Blog", target: "blog" } : undefined;
---

{route === "" ? (
  <div class="container-fluid px-0"><div id="carouselId" class="carousel slide" data-bs-ride="carousel"><div class="carousel-inner" role="listbox">
    <div class="carousel-item active"><img src="img/carousel-1.jpg" class="img-fluid" alt="Business architecture planning" /><div class="carousel-caption"><div class="container carousel-content"><h6 class="text-secondary h4 animated fadeInUp">Best Enterprise Solutions</h6><h1 class="text-white display-1 mb-4 animated fadeInRight">Architecture. Technology. Transformation.</h1><p class="mb-4 text-white fs-5 animated fadeInDown">We manage business and technology complexities allowing you to focus on delivering your unique value proposition to your customer.</p><a href={pageHref(route, "about")} class="me-2 px-4 py-sm-3 px-sm-5 btn btn-primary rounded-pill carousel-content-btn1">Read More</a><a href={pageHref(route, "contact")} class="ms-2 px-4 py-sm-3 px-sm-5 btn btn-primary rounded-pill carousel-content-btn2">Contact Us</a></div></div></div>
    <div class="carousel-item"><img src="img/carousel-2.jpg" class="img-fluid" alt="Business and IT alignment" /><div class="carousel-caption"><div class="container carousel-content"><h6 class="text-secondary h4 animated fadeInUp">Architecture Alignment</h6><h1 class="text-white display-1 mb-4 animated fadeInLeft">Business And IT Architecture Alignment.</h1><p class="mb-4 text-white fs-5 animated fadeInDown">We help businesses design and implement effective architecture strategies that align with their goals and drive innovation.</p><a href={pageHref(route, "services/enterprise-architecture")} class="me-2 px-4 py-sm-3 px-sm-5 btn btn-primary rounded-pill carousel-content-btn1">Read More</a><a href={pageHref(route, "contact")} class="ms-2 px-4 py-sm-3 px-sm-5 btn btn-primary rounded-pill carousel-content-btn2">Contact Us</a></div></div></div>
  </div><button class="carousel-control-prev" type="button" data-bs-target="#carouselId" data-bs-slide="prev"><span class="carousel-control-prev-icon" aria-hidden="true"></span><span class="visually-hidden">Previous</span></button><button class="carousel-control-next" type="button" data-bs-target="#carouselId" data-bs-slide="next"><span class="carousel-control-next-icon" aria-hidden="true"></span><span class="visually-hidden">Next</span></button></div></div>
) : (
  <header class="container-fluid page-header py-5"><div class="container text-center py-5"><h1 class="display-3 text-white mb-4">{heading}</h1><nav aria-label="Breadcrumb"><ol class="breadcrumb justify-content-center mb-0"><li class="breadcrumb-item"><a href={pageHref(route, "")}>Home</a></li>{section && <li class="breadcrumb-item"><a href={pageHref(route, section.target)}>{section.label}</a></li>}<li class="breadcrumb-item active" aria-current="page">{heading}</li></ol></nav></div></header>
)}
