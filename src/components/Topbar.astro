---
import { siteConfig } from "../config";
---

<div class="container-fluid bg-dark py-2 d-none d-md-flex"><div class="container"><div class="d-flex justify-content-between topbar">
  <div class="top-info"><small class="me-3 text-white-50"><i class="fas fa-map-marker-alt me-2 text-secondary"></i>{siteConfig.location}</small><small class="me-3"><a class="text-white-50" href={`mailto:${siteConfig.email}`}><i class="fas fa-envelope me-2 text-secondary"></i>{siteConfig.email}</a></small></div>
  <div class="top-link"><a href={siteConfig.facebookUrl} aria-label="Facebook" class="bg-light nav-fill btn btn-sm-square rounded-circle"><i class="fab fa-facebook-f text-primary"></i></a><a href={siteConfig.xUrl} aria-label="X" class="bg-light nav-fill btn btn-sm-square rounded-circle"><i class="fab fa-twitter text-primary"></i></a><a href={siteConfig.linkedinUrl} aria-label="LinkedIn" class="bg-light nav-fill btn btn-sm-square rounded-circle me-0"><i class="fab fa-linkedin-in text-primary"></i></a></div>
</div></div></div>
