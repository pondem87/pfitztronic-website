---
import { siteConfig } from "../config";
import { pageHref } from "../paths";
interface Props { route: string }
const { route } = Astro.props;
const logoPath = route.includes("/") ? "../img/logo.png" : "img/logo.png";
---

<footer class="container-fluid footer bg-dark wow fadeIn" data-wow-delay=".3s"><div class="container pt-5 pb-4"><div class="row g-5">
  <div class="col-lg-3 col-md-6"><a href={pageHref(route, "")} class="d-flex align-items-center"><img src={logoPath} alt="Pfitztronic logo" class="img-fluid me-2" width="60" height="60" /><span class="h1 text-white fw-bold m-0">Pfitz<span class="text-secondary">tronic</span></span></a><p class="mt-4 text-light">Our customer is a hands-on business owner or entrepreneur who is execution-driven and committed to operational excellence.</p><div class="d-flex hightech-link"><a href={siteConfig.facebookUrl} aria-label="Facebook" class="btn-light nav-fill btn btn-square rounded-circle me-2"><i class="fab fa-facebook-f text-primary"></i></a><a href={siteConfig.xUrl} aria-label="X" class="btn-light nav-fill btn btn-square rounded-circle me-2"><i class="fab fa-twitter text-primary"></i></a><a href={siteConfig.linkedinUrl} aria-label="LinkedIn" class="btn-light nav-fill btn btn-square rounded-circle"><i class="fab fa-linkedin-in text-primary"></i></a></div></div>
  <div class="col-lg-3 col-md-6"><span class="h3 text-secondary">Short Links</span><div class="mt-4 d-flex flex-column short-link"><a href={pageHref(route, "about")} class="mb-2 text-white"><i class="fas fa-angle-right text-secondary me-2"></i>About us</a><a href={pageHref(route, "contact")} class="mb-2 text-white"><i class="fas fa-angle-right text-secondary me-2"></i>Contact us</a><a href={pageHref(route, "service")} class="mb-2 text-white"><i class="fas fa-angle-right text-secondary me-2"></i>Our Services</a><a href={pageHref(route, "projects/iot-hub")} class="mb-2 text-white"><i class="fas fa-angle-right text-secondary me-2"></i>IoT Hub</a><a href={pageHref(route, "blog")} class="mb-2 text-white"><i class="fas fa-angle-right text-secondary me-2"></i>Latest Blog</a></div></div>
  <div class="col-lg-3 col-md-6"><span class="h3 text-secondary">Useful Links</span><div class="mt-4 d-flex flex-column help-link"><a href={pageHref(route, "privacy")} class="mb-2 text-white"><i class="fas fa-angle-right text-secondary me-2"></i>Privacy Policy</a><a href={pageHref(route, "faqs")} class="mb-2 text-white"><i class="fas fa-angle-right text-secondary me-2"></i>FAQs</a><a href={pageHref(route, "contact")} class="mb-2 text-white"><i class="fas fa-angle-right text-secondary me-2"></i>Contact</a></div></div>
  <div class="col-lg-3 col-md-6"><span class="h3 text-secondary">Contact Us</span><div class="text-white mt-4 d-flex flex-column contact-link"><span class="pb-3 text-light border-bottom border-primary"><i class="fas fa-map-marker-alt text-secondary me-2"></i>{siteConfig.location}</span><a href={`tel:${siteConfig.phoneHref}`} class="py-3 text-light border-bottom border-primary"><i class="fas fa-phone-alt text-secondary me-2"></i>{siteConfig.phoneDisplay}</a><a href={`mailto:${siteConfig.email}`} class="py-3 text-light border-bottom border-primary"><i class="fas fa-envelope text-secondary me-2"></i>{siteConfig.email}</a></div></div>
</div><hr class="text-light mt-5 mb-4" /><div class="row"><div class="col-md-6 text-center text-md-start"><span class="text-light"><i class="fas fa-copyright text-secondary me-2"></i><span class="text-secondary">Pfitztronic Pty Ltd</span>, All rights reserved.</span></div><div class="col-md-6 text-center text-md-end"><span class="text-light">Designed By <a href="https://htmlcodex.com" class="text-secondary">HTML Codex</a></span></div></div></div></footer>
